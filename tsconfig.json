{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "types": ["vite/client"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "paths": {
      "@components/*": ["./src/app/components/*"],
      "@configs/*": ["./src/app/configs/*"],
      "@locales/*": ["./src/app/locales/*"],
      "@sections/*": ["./src/app/main/sections/*"],
      "@styles/*": ["./src/app/styles/*"],
      "@utils/*": ["./src/app/utils/*"],
      "@i18n": ["./src/i18n.ts"]
    },
    "allowImportingTsExtensions": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "script/**/*.ts", "vite.config.ts"],
  "exclude": ["node_modules", "build"]
}
