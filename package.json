{
  "name": "kreobuddha-ui-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for @kreobuddha/ui",
  "license": "MIT",
  "author": "Rustam Ishmukhametov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kreobuddha/kreobuddha-ui-docs.git"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite-react-ssg build && npm run index",
    "build:e2e": "VITE_BASE_PATH=/kreobuddha-ui-docs/ npm run build",
    "preview": "vite preview",
    "serve": "node scripts/serve-export.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/*.test.ts'",
    "e2e": "npm run build:e2e && playwright test",
    "verify": "npm run typecheck && npm test && npm run e2e && npm run check:css && npm run check:links",
    "check:css": "node scripts/check-css-layers.mjs",
    "check:links": "node scripts/check-links.mjs",
    "index": "pagefind --site dist",
    "lighthouse:mobile": "lhci autorun --config=lighthouse/mobile.cjs",
    "lighthouse:desktop": "lhci autorun --config=lighthouse/desktop.cjs",
    "lighthouse": "npm run lighthouse:mobile && npm run lighthouse:desktop"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@kreobuddha/ui": "^1.0.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.4.3",
    "@vitejs/plugin-react": "^6.1.0",
    "i18next": "^26.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^6.30.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "shiki": "^4.4.3",
    "vite": "^8.2.2",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@fontsource/inter": "^5.3.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
